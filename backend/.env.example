# Application Settings
PROJECT_NAME="AI Market Trend Analysis API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# CORS Configuration (JSON array or comma-separated string)
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'
CORS_ORIGINS=http://localhost:5173

# Paths (relative to backend root or absolute)
DATASETS_DIR="datasets"
ARTIFACTS_DIR="artifacts"
DEFAULT_DATASET="aapl_stock_daily.csv"

# Market Data Provider (alpha_vantage or twelve_data)
DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# News & Sentiment Provider (gnews or newsapi)
NEWS_PROVIDER=gnews
GNEWS_API_KEY=your_gnews_api_key_here
NEWSAPI_API_KEY=your_newsapi_api_key_here

# LLM / AI Narrative Integration
GEMINI_API_KEY=your_gemini_api_key_here
